{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "letbefun.vercel.app" }],
      "destination": "https://letbe.fun/:path*",
      "permanent": true
    }
  ],
    "rewrites": [{ "source": "/((?!assets/|images/|sounds/|favicon.png|favicon.svg|logo.png|robots.txt|sitemap.xml).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
